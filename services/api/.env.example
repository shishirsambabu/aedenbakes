NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
ENABLE_DEMO_ACCOUNTS=true
EXPOSE_OTP_DEBUG_CODE=false
ENABLE_PROTOTYPE_ONBOARDING=false

# Local recovery can use a SQLite file path. R1 production gate requires postgres:// or postgresql://.
DATABASE_URL=

# Reserved for the R1 session and queue migration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
SESSION_SECRET=

# Server-side OTP verification. Keep secrets out of Flutter build artifacts.
MSG91_WIDGET_ID=
MSG91_AUTHKEY=

# The mobile SDK token is supplied to Flutter via --dart-define, not read by the API.
MSG91_AUTH_TOKEN=

# The API reports ERP unavailable until the real connector is implemented.
VASY_API_BASE_URL=
VASY_API_KEY=
VASY_WEBHOOK_SECRET=

# Optional S3-compatible object storage. Without it, documents are metadata-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
