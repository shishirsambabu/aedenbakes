{
  "name": "@aeden-bakes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/postgres-migrations.ts",
    "db:migrate:check": "tsx src/postgres-migrations.ts --check",
    "db:preflight": "tsx src/postgres-preflight.ts",
    "cutover:rehearsal": "tsx src/cutover-rehearsal.ts",
    "cutover:repair": "tsx src/cutover-rehearsal.ts --repair-missing-order-branches",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aeden-bakes/shared": "file:../../packages/shared",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
